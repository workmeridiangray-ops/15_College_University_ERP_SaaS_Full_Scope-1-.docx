# ---- Required in production -------------------------------------------------
# PostgreSQL 14+ connection string.
DATABASE_URL=postgres://user:password@host:5432/campus_erp
# Public base URL of the app (used in emailed links and payment callbacks). No trailing slash.
APP_URL=https://erp.example.com
# Directory for uploaded documents. Must be on persistent storage and backed up.
UPLOAD_DIR=/var/data/uploads

# ---- First-run super admin: EITHER open /setup in the browser (needs SETUP_TOKEN) ----
# ---- OR run `npm run db:bootstrap` with the two BOOTSTRAP_* values ------------------
# Long random phrase (16+ chars). Remove it after the administrator is created.
SETUP_TOKEN=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Email (optional but recommended) ---------------------------------------
# e.g. smtps://user:pass@smtp.example.com:465 . If unset, no email is sent and
# one-time activation/reset links are shown on screen to the administrator instead.
SMTP_URL=
MAIL_FROM="Campus ERP <no-reply@example.com>"

# ---- Razorpay (use TEST keys until go-live) ---------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay webhook (URL: APP_URL/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=

# ---- Development / demo only: never set these in production -----------------
# Leave DATABASE_URL empty to use an embedded database stored in PGLITE_DIR.
# PGLITE_DIR=.data/pglite
# Allow the embedded database under NODE_ENV=production (local smoke tests only).
# ALLOW_EMBEDDED_DB=1
# Permit `npm run db:seed-demo` under NODE_ENV=production (creates a flagged demo institution).
# ALLOW_DEMO_SEED=1

# Cloudflare Workers only (set in wrangler.jsonc, not here): DB_PER_REQUEST=1 opens one database connection per query.
