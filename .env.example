# Required in production
DATABASE_URL=postgres://user:password@host:5432/campus_erp
APP_URL=https://erp.example.com
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
UPLOAD_DIR=/var/data/uploads

# Super admin bootstrap (used once by `npm run db:bootstrap`)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Email (optional; if unset, emails are written to the notification log only)
SMTP_URL=

# Razorpay (use TEST keys until go-live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local development only: leave DATABASE_URL empty to use embedded PGlite in ./.data
